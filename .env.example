# App
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# API-Sports (Hockey) — https://dashboard.api-sports.io/
# Used only by the backend; never expose this to the mobile app.
API_SPORTS_KEY=

# Optional override (default: https://v1.hockey.api-sports.io)
# API_SPORTS_HOCKEY_BASE_URL=https://v1.hockey.api-sports.io

# NHL uses API-Sports league id 57 (no env needed unless you change leagues)

# LLM / Supabase (add when you wire those features)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
