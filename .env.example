# App
APP_ENV=development
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# API-Sports (Hockey) — https://dashboard.api-sports.io/
# Used ONLY by background jobs; user requests read Redis/Supabase.
API_SPORTS_KEY=

# Optional override (default: https://v1.hockey.api-sports.io)
# API_SPORTS_HOCKEY_BASE_URL=https://v1.hockey.api-sports.io

# Redis (free locally: docker compose up -d)
# Shared lock nhl:sync:lock:global — safe to run multiple API workers.
REDIS_URL=redis://localhost:6379/0
ENABLE_NHL_JOBS=true

# Job intervals
NHL_STANDINGS_INTERVAL_MINUTES=60
NHL_SCORES_INTERVAL_SECONDS=60
NHL_WINDOW_REFRESH_HOURS=24
NHL_WINDOW_LOOKBACK_DAYS=7
NHL_WINDOW_LOOKAHEAD_DAYS=3

# Supabase — standings persistence (hourly job)
# Create table: supabase/migrations/001_nhl_team_records.sql
# Use project URL only, e.g. https://xxxx.supabase.co (NOT .../rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (future)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
